--- !u!114 &6767560422546557442
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 732315558181950232}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 917d3f7fb8b12cc4db2bed1e7676fca3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KTH.KTH_TypingTextSignal
  text: {fileID: 366059124021106567}
  lines:
  - "\u201D\uC798 \uBA39\uACA0\uC2B5\uB2C8\uB2E4.\u201D"
  - "B\uC528\uAC00 \uCC28\uB824\uC8FC\uC2E0 \uC800\uB141 \uC2DD\uC0AC\uB294 \uC644\uBCBD\uD574
    \uBCF4\uC600\uB2E4."
  - "\uAE40\uC774 \uBAA8\uB77D\uBAA8\uB77D \uC62C\uB77C\uC624\uB294 \uBE75\uACFC
    \uBD80\uB4DC\uB7EC\uC6B4 \uC2A4\uD14C\uC774\uD06C."
  - "\uB098\uB294 \uD3EC\uD06C\uB97C \uC9D1\uC5B4 \uB4E4\uC5C8\uB2E4."
  - "\uADF8\uB9AC\uACE0 \uC55E\uC5D0 \uB193\uC778 \uC561\uC790\uB97C \uCC14\uB7EC
    \uAE68\uB728\uB838\uB2E4."
  - "\uD769\uC5B4\uC9C4 \uC720\uB9AC \uC870\uAC01\uC774 B\uC528\uC758 \uC74C\uC2DD
    \uC704\uB85C \uC3DF\uC544\uC838 \uB0B4\uB838\uB2E4."
  - "B\uC528\uB294 \uCE7C\uB85C \uB300\uCDA9 \uAC77\uC5B4\uB0B4\uB354\uB2C8\n\uACE0\uAE30
    \uD55C \uC870\uAC01\uC744 \uC798\uB77C \uC785\uC5D0 \uB123\uC5C8\uB2E4."
  - "\u201D\uB9DB\uC788\uAC8C \uBA39\uC5B4, \uC720\uD0A4.\u201D"
  - "B\uC528\uAC00 \uB2F5\uD588\uB2E4."
  - "\uAD6C\uBA4D \uB6AB\uB9B0 \uC561\uC790 \uC18D \uC0AC\uC9C4\uC774 \uBC14\uB2E5\uC73C\uB85C
    \uAD74\uB7EC \uB5A8\uC5B4\uC84C\uB2E4."
  - "\uC9C0\uD558\uC2E4\uC758 \uACF5\uAE30\uB294 \uD769\uB0A0\uB9AC\uB294 \uBA3C\uC9C0\uAC00\n\uCD08\uB85D
    \uBE5B\uC744 \uBC1B\uC544 \uB179\uC0C9\uC73C\uB85C \uBE5B\uB0AC\uB2E4."
  - "\uB098\uB294 \uCE7C\uC744 \uAC70\uAFB8\uB85C \uC950\uACE0 \uC778\uD615\uC758
    \uAC00\uC2B4\uD30D\uC5D0 \uB0A0\uC744 \uAF42\uC558\uB2E4."
  - "\uB454\uD0C1\uD55C \uC18C\uB9AC\uC640 \uD568\uAED8 \uC778\uD615 \uC548\uC5D0
    \uC228\uACA8\uC838 \uC788\uB358\n\uBB3C\uAC10 \uC8FC\uBA38\uB2C8\uAC00 \uD130\uC9C0\uBA70
    \uBE68\uAC04 \uD53C\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4."
  - "\uB108\uBB34\uB098 \uB2F9\uC5F0\uD588\uB2E4."
  - "\uC2DC\uACC4\uAC00 \uC6B8\uB838\uACE0, \uB0B4 \uC55E\uC5D0\uB294 \uC545\uB9C8\uAC00
    \uC788\uC5C8\uB2E4."
  - "\u201D\uC720\uD0A4, \uC774\uBC88\uC5D0\uB294 \uC65C \uCC0C\uB978 \uAC70\uB2C8?\u201D"
  - "B\uC528\uAC00 \uB9DE\uC740 \uD3B8\uC5D0\uC11C \uBB3C\uC5C8\uB2E4."
  - "\u201D\u2026\uC2DC\uACC4\uAC00 \uC6B8\uB838\uC73C\uB2C8\uAE4C\uC694?\u201D"
  - "\uB098\uB294 B\uC528\uC758 \uC9C8\uBB38\uC744 \uC774\uD574\uD558\uC9C0 \uBABB\uD588\uB2E4."
  - "\uC0AC\uB78C\uC774 \uBB3C \uC18D\uC5D0\uC11C \uC8FD\uACE0,\n\uBE44\uAC00 \uB0B4\uB9AC\uBA74
    \uD638\uC218\uAC00 \uB118\uCE58\uB294 \uAC83\uCC98\uB7FC \uB2F9\uC5F0\uD588\uB2E4."
  - "\uB0B4 \uB2F5\uC5D0 B\uC528\uB294 \uBB34\uD45C\uC815\uD558\uAC8C \uC790\uB9AC\uC5D0\uC11C
    \uC77C\uC5B4\uB0AC\uB2E4."
  - "\uC591 \uB208\uC379\uC740 \uC62C\uB77C\uAC00\uACE0, \uC785\uC740 \uC77C\uADF8\uB7EC\uC9C4
    \uCC44\uB85C."
  - "B\uC528\uB294 \uD3C9\uC628\uD558\uAC8C \uB4A4\uC5D0 \uC5F4\uB9B0 \uBB38\uC73C\uB85C
    \uD5A5\uD588\uB2E4."
  - "\uBC29 \uC548\uC5D0\uC11C \uBB34\uC5B8\uAC00\uB97C \uBC30\uB294 \uC18C\uB9AC\uC640
    \uC5F0\uC774\uC5B4 \uB4E4\uB824\uC654\uB2E4."
  - "\uBD80\uB4DC\uB7EC\uC6B4 \uACE0\uAE30\uAC00 \uC370\uB9AC\uB294 \uACBD\uCF8C\uD55C
    \uC18C\uB9AC\uC600\uB2E4."
  - "\uC218\uC2ED \uBC88\uC774 \uC9C0\uB098\uACE0 \uB098\uC11C\uC57C\n\uC637\uC744
    \uAC08\uC544\uC785\uC740 B\uC528\uAC00 \uADF8 \uC548\uC5D0\uC11C \uB098\uC654\uB2E4."
  - "\u201DB\uC528, \uC0C8\uB85C \uC0B0 \uC2A4\uC6E8\uD130 \uC778\uAC00\uC694?\u201D"
  - "\u201D\uBE68\uAC04\uC0C9 \uC2A4\uC6E8\uD130\uAC00 \uC798 \uC5B4\uC6B8\uB9B4
    \uC904 \uBAB0\uB790\uC5B4\uC694.\u201D"
  - "\u201D\uD56D\uC0C1 \uD558\uC580 \uC0C9\uB9CC \uC785\uC73C\uC2DC\uB354\uB2C8.\u201D"
  - "\u201D..\uC774\uC81C \uC62C\uB77C\uAC00\uC790.\u201D"
  - "B\uC528\uB294 \uBC29\uC758 \uBB38\uC744 \uC790\uBB3C\uC1E0\uB85C \uAC78\uC5B4
    \uC7A0\uADF8\uACE4\n\uC5F4\uC1E0\uB97C \uC9C0\uD558\uCC3D \uBC16\uC73C\uB85C
    \uB358\uC838\uBC84\uB838\uB2E4."
