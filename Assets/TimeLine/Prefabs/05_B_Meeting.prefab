--- !u!114 &5721460358409268056
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4440638838971907462}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 917d3f7fb8b12cc4db2bed1e7676fca3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KTH.KTH_TypingTextSignal
  text: {fileID: 3465939611605328570}
  lines:
  - "\u201D\uC815\uB9D0.. \uAC10\uC0AC\uD569\uB2C8\uB2E4. \uAC10\uC0AC\uD569\uB2C8\uB2E4..\u201D"
  - "\uBD80\uBAA8\uB2D8\uC774 B\uC528\uC758 \uC190\uC744 \uB450 \uC190\uC73C\uB85C
    \uC7A1\uC558\uB2E4."
  - "\u201D\uC720\uD0A4\uB294 \uD2B9\uBCC4\uD55C \uC544\uC774\uB2C8\uAE4C\uC694.\n\uBD80\uBAA8\uB2D8\uB4E4\uAED8\uC11C
    \uC798 \uB3CC\uBD10 \uC8FC\uC138\uC694.\u201D"
  - "B\uC528\uB294 \u2018\uC9C0\uC6D0 \uC2E0\uCCAD\uC11C\u2019\uB77C\uACE0 \uC4F0\uC778
    \uBB38\uC11C \uBB49\uCE58\uC5D0\n\uBB50\uB77C\uACE0 \uD718\uAC08\uACA8 \uC4F0\uB354\uB2C8
    \uC544\uBE60\uC5D0\uAC8C \uAC74\uB0C8\uB2E4."
  - "\u201D\uC55E\uC73C\uB85C \uB9E4 \uB2EC\uB9C8\uB2E4 \uC544\uBC84\uB2D8 \uC55E\uC73C\uB85C\n\uC218\uD45C\uAC00
    \uD55C \uC7A5\uC529 \uB3C4\uCC29\uD560 \uAC81\uB2C8\uB2E4.\u201D"
  - "\u201D\uC0AC\uC6A9\uD560 \uB54C\uB294, \uC740\uD589\uC5D0\uC11C\n\uC5EC\uAE30
    \uC11C\uBA85\uACFC \uC2DD\uBCC4 \uBC88\uD638\uB97C \uBCF4\uC5EC\uC8FC\uBA74 \uB429\uB2C8\uB2E4.\u201D"
  - "\uADF8\uB294 \uC218\uD45C \uC704\uC5D0 \u2018B\u2019\uB77C\uB294 \uC0AC\uC778\uC744
    \uB0A8\uACBC\uB2E4."
  - "B\uC528\uB294 \uC544\uC774\uC2A4\uD06C\uB9BC \uD2B8\uB7ED \uC55E\uC5D0\uC11C
    \uB9CC\uB09C \uB0A0 \uB4A4\uB85C\n\uBA87 \uBC88 \uB354 \uB0B4\uAC8C \uC544\uC774\uC2A4\uD06C\uB9BC\uC744
    \uC0AC\uC8FC\uC5C8\uB2E4."
  - "\uADF8 \uC7A0\uAE50\uC758 \uC2DC\uAC04 \uB3D9\uC548 \uC6B0\uB9AC\uB294 \uB9CE\uC740
    \uB300\uD654\uB97C \uB098\uB204\uC5C8\uACE0,"
  - "\uB9C8\uCE68\uB0B4 B\uC528\uAC00 \uC6B0\uB9AC \uAC00\uC871\uC744 \uB3D5\uAE30\uB85C
    \uACB0\uC2EC\uD55C \uAC83\uC774\uB2E4."
  - "\uB098\uB294 \uADF8 \uB0A0 \uB4A4\uB85C \uB9E4 \uC8FC\uB9D0\uC774 \uB418\uBA74\nB\uC528\uB97C
    \uB9CC\uB0A0 \uC218 \uC788\uC5C8\uB2E4."
  - "\uADF8\uB7F0 \uB0A0\uC5D0\uB294 B\uC528\uC640 \uD3C9\uC18C\uC5D0 \uAC08 \uC218
    \uC5C6\uC5C8\uB358\n\uCEE4\uB2E4\uB780 \uC7A5\uB09C\uAC10 \uC0C1\uC810\uC5D0
    \uAC00\uAC70\uB098 \uACF5\uC6D0\uC744 \uC0B0\uCC45 \uD558\uACE4 \uD588\uB2E4."
  - "B\uC528\uB294 \uB298 \uBCC4 \uB9D0\uC774 \uC5C6\uC5C8\uC9C0\uB9CC\n\uB0B4\uAC00
    \uC2E0\uB098\uC11C \uC5B4\uB518\uAC00\uB85C \uB6F0\uC5B4\uAC00\uB3C4 \uD56D\uC0C1
    \uC606\uC5D0 \uC788\uC5C8\uB2E4."
  charInterval: 0.05
  clearOnEnable: 1
