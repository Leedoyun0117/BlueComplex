--- !u!114 &9205479386067305904
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1568417909337305597}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 917d3f7fb8b12cc4db2bed1e7676fca3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KTH.KTH_TypingTextSignal
  text: {fileID: 2678336327734629777}
  lines:
  - "\uC5F0\uD68C\uB85C \uD5A5\uD558\uB294 \uCC28 \uC548\uC740\nB\uC528\uC758 \uCF54\uD2B8\uAC00
    \uC2DC\uD2B8\uC640 \uB2FF\uC544 \uB0B4\uB294 \uC18C\uB9AC\uB9CC \uB4E4\uB838\uB2E4."
  - "B\uC528\uB294 \uAC00\uB054 \uCC3D \uBC16\uC744 \uBC14\uB77C\uBCF4\uAC70\uB098
    \uC791\uC740 \uD63C\uC7A3\uB9D0\uC744 \uC911\uC5BC\uAC70\uB9AC\uBA70\n\uBB34\uB8CC\uD55C
    \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uACE0 \uC788\uC5C8\uC9C0\uB9CC,"
  - "\uB098\uB294 \uAC00\uB9CC\uD788 \uC549\uC544 \uC6C0\uC9C1\uC774\uC9C0 \uBABB\uD588\uB2E4."
  - "\uCC3D\uAC00\uC5D0 \uBD80\uB52A\uD788\uB294 \uBE57\uBC29\uC6B8\uC774 \uBC14\uB78C\uC5D0
    \uB9DE\uC544 \uB0A0\uC544\uAC00\uBA70\n\uD76C\uBFCC\uC5F0 \uC790\uCDE8\uB97C
    \uB0A8\uACBC\uB2E4."
  - "\uC5D4\uC9C4\uC758 \uB0AE\uC740 \uC9C4\uB3D9\uB3C4 \uBE57\uC18C\uB9AC\uC5D0
    \uC11E\uC5EC\uC11C\n\uAC80\uD478\uB978 \uD558\uB298\uC744 \uBD80\uC815\uD560
    \uC218 \uC5C6\uC5C8\uB2E4."
  - "B : \uC720\uD0A4, \uAE30\uBD84\uC774 \uC5B4\uB54C?"
  - "\uC720\uD0A4 : \uADF8\uB0E5.. \uC798 \uBAA8\uB974\uACA0\uC5B4\uC694."
  - "\uC720\uD0A4 : \uD558\uD544 \uBE44\uB3C4 \uC624\uACE0 \uB9D0\uC774\uC8E0."
  - "\uC720\uD0A4 : \uC561\uC790 \uC18D \uC545\uB9C8\uB4E4\uC744 \uC2E4\uC81C\uB85C
    \uBCF4\uBA74.."
  - "B\uC528\uB294 \uADF8\uAC04 \uBCF8 \uC801 \uC5C6\uB294, \uCC28\uAC00\uC6B4 \uBBF8\uC18C\uB97C
    \uC9C0\uC73C\uBA70\n\uB0B4\uAC8C \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4."
  - "\uD558\uC9C0\uB9CC \uADF8 \uB0C9\uC18C\uAC00 \uB098\uB97C \uD5A5\uD55C \uAC83\uC774
    \uC544\uB2C8\uB77C\uB294 \uAC78\n\uB290\uB084 \uC218 \uC788\uC5C8\uB2E4."
  - "B : \uADF8\uB7F4 \uB54C\uB294 \uC2DC\uACC4\uB97C \uB5A0\uC62C\uB824."
  - "B : \uB098\uB3C4 \uAC81 \uBA39\uC744 \uB54C\uBA74, \uBB34\uC5B8\uAC00\uB97C
    \uB5A0\uC62C\uB9AC\uAC70\uB4E0."
  - "\uC720\uD0A4 : B\uC528\uAC00\uC694?"
  - "\uC720\uD0A4 : \uC545\uB9C8\uB4E4\uC774 \uB450\uB824\uC6B4 \uAC74\uAC00\uC694?"
  - "B : \uC720\uD0A4, \uB10C \uB0B4\uAC00 \uC545\uB9C8\uB4E4\uACFC \uB9DE\uC11C\uC57C
    \uD55C\uB2E4\uACE0 \uC0DD\uAC01\uD574?"
  - "\uCC98\uC74C \uB4E3\uB294 \uC9C8\uBB38\uC774\uC5C8\uB2E4."
  - "\uB098\uB294 \uB2E8 \uD55C \uBC88\uB3C4,\nB\uC528\uAC00 \uC545\uB9C8\uC640 \uC2F8\uC6B0\uACE0
    \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC9C0 \uC54A\uC558\uB2E4."
  - "\uADF8\uB4E4\uC740 \uADF8\uB0E5 \uC874\uC7AC\uD560 \uBFD0,\n\uC2F8\uC6C0\uC774\uB098
    \uD3ED\uB825\uC758 \uB300\uC0C1\uC774 \uC544\uB2C8\uC5C8\uB2E4."
  - "\uC720\uD0A4 : \uD544\uC694\uD558\uB2E4\uBA74, \uADF8\uB798\uC57C\uACA0\uC8E0."
  - "\uC720\uD0A4 : \uD558\uC9C0\uB9CC \uADF8\uAC8C B\uC528\uB97C \uC704\uD5D8\uC5D0
    \uBE60\uB728\uB9B0\uB2E4\uBA74.."
  - 'B : ...'
  - "\uC720\uD0A4 : \uADF8\uB7F0 \uAC70\uB77C\uBA74, \uC6B0\uB9AC \uAC19\uC774 \uD574\uACB0\uD574
    \uBD10\uC694."
  - "\uC720\uD0A4 : \uADF8\uAC8C B\uC528\uB97C \uD589\uBCF5\uD558\uAC8C \uB9CC\uB4DC\uB294
    \uC77C\uC778\uAC00\uC694?"
  - "B : \uBAA8\uB974\uACA0\uC5B4."
  - "\uC720\uD0A4 : \uADF8\uAC8C \uBB34\uC2A8.."
  - "B : \uB10C \uD2B9\uBCC4\uD574, \uC720\uD0A4."
  - "B : \uB098\uC640 \uB2E4\uB974\uAC8C."
  - "\uB098\uB294 B\uC528\uAC00 \uBB34\uC2A8 \uB9D0\uC744 \uD558\uB294 \uAC74\uC9C0
    \uC774\uD574\uD560 \uC218 \uC5C6\uC5C8\uB2E4."
  - "\uBE44\uC5D0 \uC816\uC5B4 \uAC80\uAC8C \uBCC0\uD55C \uB3C4\uB85C\uB97C \uC9C0\uB098\n\uD759\uAE38\uC5D0
    \uB2FF\uC744 \uB54C\uAE4C\uC9C0."
  - "\uACC4\uC18D \uC0DD\uAC01\uD574 \uBCF4\uC558\uC9C0\uB9CC\n\uC790\uB3D9\uCC28\uAC00
