--- !u!114 &4986850192204410887
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 397489808495179898}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 917d3f7fb8b12cc4db2bed1e7676fca3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KTH.KTH_TypingTextSignal
  text: {fileID: 3976288946333571265}
  lines:
  - "\uBE44\uAC00 \uAC70\uC138\uAC8C \uBAB0\uC544\uCCE4\uB2E4."
  - "\uB098\uB294 B\uC528\uC758 \uB9D0\uCC98\uB7FC \uD574\uBCC0\uAC00\uC5D0 \uC11C
    \uC788\uB2E4\uAC00\n\uBD80\uBAA8\uB2D8\uC774 \uBB34\uC5B8\uAC00\uB97C \uAC00\uC9C0\uB7EC
    \uAC04 \uC0AC\uC774"
  - "\uBA40\uB9AC \uC788\uB294 \uBC14\uC704 \uB4A4\uC5D0 \uBAB8\uC744 \uC228\uACBC\uB2E4."
  - "\uC791\uAC8C \uC6C3\uC74C\uC774 \uB098\uC654\uB2E4."
  - "\uBD80\uBAA8\uB2D8\uC774 \uB0A0 \uCC3E\uC744 \uC218 \uC788\uC744\uAE4C?"
  - "\uACF3 \uC774\uC5B4, \uB79C\uD134\uC744 \uB4E0 \uC544\uBC84\uC9C0\uAC00\n\uD574\uBCC0\uAC00\uB97C
    \uBE44\uCD94\uBA70 \uB0B4 \uC774\uB984\uC744 \uBD80\uB974\uAE30 \uC2DC\uC791\uD588\uB2E4."
  - "\uC870\uAE08\uB9CC \uB354 \uC788\uB2E4\uAC00 \uB098\uAC00\uBA74 \uAE5C\uC9DD
    \uB180\uB784 \uAC8C \uBD84\uBA85\uD574."
  - "\uB098\uB294 \uB208\uB9CC \uB0B4\uBC00\uACE0 \uACC4\uC18D \uC9C0\uCF1C \uBCF4\uC558\uB2E4."
  - "\uBE57\uC904\uAE30\uB294 \uACC4\uC18D \uAD75\uC5B4\uC9C0\uAE30\uB9CC \uD588\uB2E4."
  - "\uAC70\uC13C \uBE57\uBC29\uC6B8\uACFC \uBC14\uB78C\uC774 \uB9CC\uB098\n\uD574\uBCC0\uAC00\uC758
    \uBAA8\uC2B5\uC774 \uD750\uB824\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4."
  - "\uC5B4\uB290 \uC21C\uAC04, \uB79C\uD134\uC758 \uBE5B\uC774 \uB354 \uC774\uC0C1
    \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4."
  - "\u201D\uC544\uBE60! \uC5C4\uB9C8! \uC800 \uC5EC\uAE30 \uC788\uC5B4\uC694!\u201D"
  - "\uBB34\uC5B8\uAC00 \uBD88\uC548\uD574\uC9C4 \uB098\uB294\n\uC628 \uD798\uC744
    \uB2E4\uD574 \uBD80\uBAA8\uB2D8\uC744 \uBD88\uB800\uB2E4."
  - "\uD558\uC9C0\uB9CC \uB0B4 \uBAA9\uC18C\uB9AC\uB294 \uD3ED\uD48D\uC5D0 \uB9C9\uD600
    \uD769\uC5B4\uC838 \uBC84\uB838\uB2E4."
  - "\uC7A0\uAE50 \uC2A4\uCCD0\uAC00\uB294 \uC7A5\uBA74\uC5D0,\n\uBD80\uBAA8\uB2D8\uC774
    \uBC14\uB2F7 \uC18D\uC744 \uB4E4\uC5EC\uB2E4 \uBCF4\uB294 \uBAA8\uC2B5\uC774
    \uBCF4\uC600\uB2E4."
  - "\uB098\uB294 \uC11C\uB458\uB7EC \uBAB8\uC744 \uC77C\uC73C\uCF30\uB2E4."
  - "\u201D\uC544!\u201D"
  - "\uD558\uC9C0\uB9CC \uBC14\uC704 \uD2C8\uC5D0 \uB07C\uC5B4\uBC84\uB9B0\n\uC67C
    \uBC1C\uBAA9\uC5D0\uC11C \uD1B5\uC99D\uC774 \uC62C\uB77C\uC654\uB2E4."
  - "\uB450 \uC190\uC73C\uB85C \uC885\uC544\uB9AC\uB97C \uC7A1\uC544 \uBE7C\uB0B4\uB824
    \uD588\uC9C0\uB9CC\n\uB2E8\uB2E8\uD55C \uBC14\uC704\uB294 \uAC70\uCE5C \uC190\uC544\uADC0\uB85C
    \uB098\uB97C \uB193\uC9C0 \uC54A\uC558\uB2E4."
  - "\uD750\uB9B0 \uC2E4\uB8E8\uC5E3."
  - "\uC5C4\uB9C8\uAC00 \uBC14\uB2F7\uC18D\uC73C\uB85C \uAC78\uC5B4 \uB4E4\uC5B4\uAC14\uB2E4."
  - "\uC544\uBE60\uB294 \uACC4\uC18D \uB0B4 \uC774\uB984\uC744 \uBD80\uB974\uBA70\n\uC5EC\uAE30
    \uC800\uAE30\uB97C \uBE44\uCD94\uACE0 \uC788\uC5C8\uB2E4."
  - "\u201D\uC5C4\uB9C8! \uB098.. \uC5EC\uAE30 \uC788\uC5B4\uC694!\u201D"
  - "\uB098\uB294 \uB2E4\uB9AC\uB97C \uBE7C\uB0B4\uB824 \uC560\uC4F0\uBA70 \uACC4\uC18D\uD574\uC11C
    \uC18C\uB9AC\uCCE4\uB2E4."
  - "\u201D\uC544\uBE60\u2026!\u201D"
  - "\uCCA0\uC369\uAC70\uB9AC\uB294 \uC18C\uB9AC\uC640 \uD568\uAED8 \uC5C4\uCCAD\uB09C
    \uBB3C\uBCF4\uB77C\uAC00 \uC77C\uC5C8\uB2E4."
  - "\uBC14\uB78C\uC744 \uB9DE\uC740 \uD30C\uB3C4\uAC00 \uBAB8\uC9D1\uC744 \uBD88\uB9AC\uACE0
    \uC788\uC5C8\uB2E4."
  - "\u201D\uC81C\uBC1C\u2026\uC5EC\uAE30 \uC788\uB2E4\uACE0\uC694!\u201D"
  - "\uB208\uBB3C \uCF67\uBB3C\uC774 \uD758\uB7EC \uBE57\uBB3C\uACFC \uC11E\uC600\uB2E4."
  - "\uC591 \uBEA8\uC73C\uB85C \uD758\uB7EC\uB0B4\uB824\uC628 \uBE57\uBB3C\uC5D0\uC11C
    \uC9E0 \uB9DB\uC774 \uB3CC\uC558\uB2E4."
  - "\uC5BC\uB9C8\uB098 \uC9C0\uB0AC\uC744\uAE4C."
  - "\uBE57\uC904\uAE30\uAC00 \uC605\uC5B4\uC84C\uB2E4."
  - "\uB098\uB294 \uC5BC\uAD74\uC744 \uB2E6\uC544\uB0B4\uACE0 \uD574\uBCC0\uAC00\uB97C
    \uBC14\uB77C\uBCF4\uC558\uB2E4."
  - "\uBAA8\uB798 \uC0AC\uC7A5\uC5D0 \uC544\uBB34\uB807\uAC8C \uC4F0\uB7EC\uC9C4
    \uB79C\uD134."
  - "\uADF8\uB9AC\uACE0 \uC544\uBC84\uC9C0\uC758 \uAC89\uC637\uC774 \uBCF4\uC600\uB2E4."
  - "\uD558\uC9C0\uB9CC \uB450 \uBD84\uC758 \uBAA8\uC2B5\uC740 \uC5B4\uB514\uC5D0\uB3C4
    \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4."
  - "\uC815\uC2E0\uC744 \uCC28\uB824 \uBCF4\uB2C8\n\uB0B4 \uBC1C\uBAA9\uC744 \uBD99\uC7A1\uB358
    \uBC14\uC704\uC758 \uBAA8\uC2B5\uC5D0 \uC9D1\uC911\uD560 \uC218 \uC788\uC5C8\uB2E4."
  - "\uD53C\uAC00 \uBCA0\uC5B4\uB098\uC654\uC9C0\uB9CC \uD1B5\uC99D\uC774 \uB290\uAEF4\uC9C0\uC9C0
    \uC54A\uC558\uB2E4."
  - "\uB2E4\uB9AC\uB97C \uBE7C\uB0B4\uACE0, \uB098\uB294 \uD574\uBCC0\uAC00\uB85C
    \uB2EC\uB824\uAC14\uB2E4."
  - "\uD30C\uB3C4\uC5D0 \uD729\uC4F8\uB824 \uC54C\uC544\uBCF4\uAE30 \uC27D\uC9C0
    \uC54A\uC558\uC9C0\uB9CC,\n\uC0AC\uB78C \uB450 \uBA85\uC758 \uBC1C\uC790\uAD6D\uC774
    \uB0A8\uC544\uC788\uC5C8\uB2E4."
  - "\uADF8\uB9AC\uACE0, \uADF8 \uBC1C\uC790\uAD6D\uC740 \uBB3C \uC18D\uC73C\uB85C
    \uAC78\uC5B4 \uB4E4\uC5B4 \uAC14\uB2E4."
  - "\uBA87 \uC2DC\uAC04\uC744 \uB4A4\uC838\uB3C4 \uB2E4\uC2DC \uB098\uC628 \uD754\uC801\uC740
    \uCC3E\uC544\uBCFC \uC218 \uC5C6\uC5C8\uB2E4."
  charInterval: 0.05
  clearOnEnable: 1
  typingSfx: {fileID: 8300000, guid: babdb331464db794aa4a7a31388a951c, type: 3}
  typingSfxVolume: 0.35
  typingSfxMinInterval: 0.06
  typingSfxPitch: {x: 0.95, y: 1.05}
