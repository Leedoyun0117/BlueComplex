  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KTH.KTH_TypingTextSignal
  text: {fileID: 7149819404053562493}
  lines:
  - "\u201D\uC774\uAC8C \uBB50\uC57C?\u201D"
  - "\u201D\uC624\uB298\uC740\u2026 \uB108\uBB34\uB098 \uC6B0\uC6B8\uD55C \uD558\uB8E8\uC600\uB2E4..\u201D"
  - "\u201D\uCC28\uB77C\uB9AC \uC8FD\uACE0 \uC2F6\uC744 \uB9CC\uD07C \uACE0\uD1B5\uC2A4\uB7EC\uC6E0\uB2E4.\u201D"
  - "\uB0B4 \uC790\uB9AC\uB85C \uBAA8\uC5EC\uB4E0 \uB3D9\uAE09\uC0DD\uB4E4\uC774\n\uC77C\uAE30\uC7A5\uC744
    \uB4E4\uCDB0\uBCF4\uBA70 \uB9D0\uD588\uB2E4."
  - "\uADF8\uB4E4\uC758 \uBAA9\uC18C\uB9AC\uC5D0\uB294 \uD610\uC624\uC640 \uB0C9\uC18C\uAC00
    \uBCA0\uC5B4\uC788\uC5C8\uB2E4."
  - "\uD3C9\uC18C\uC5D0 \uAD00\uC2EC\uC870\uCC28 \uC8FC\uC9C0 \uC54A\uB358 \uC774\uB4E4\uC774\n\uC65C
    \uAC11\uC790\uAE30 \uB098\uB97C \uB4E4\uBCF6\uB294\uC9C0 \uADF8 \uB54C\uB294
    \uC774\uD574\uD558\uC9C0 \uBABB\uD588\uB2E4."
  - "\u201D\uC57C, \uC720\uD0A4.\u201D"
  - "\u201D\uB108 \uC0DD\uAC01\uBCF4\uB2E4 \uB354 \uC74C\uCE68\uD55C \uC560\uC600\uAD6C\uB098.\u201D"
  - "\u201D\uC544\uC624, \uC18C\uB984\uB07C\uCCD0!\u201D"
  - "\uBAA8\uC5EC\uB4E0 \uB3D9\uAE09\uC0DD\uB4E4 \uC911 \uAC00\uC7A5 \uD0A4\uAC00
    \uD070 \uD55C \uBA85\uC774 \uB9D0\uD588\uB2E4."
  - "\uADF8\uB7EC\uACE4 \uB0B4 \uC606\uC73C\uB85C \uC3DF\uC544\uC9C4 \uD544\uD1B5\uC5D0\uC11C\n\uD39C
    \uD55C \uC790\uB8E8\uB97C \uAEBC\uB0B4\uB4E4\uC5C8\uB2E4."
  - "\u201D\uC720\uD0A4, \uD798\uB4E4\uC5C8\uC9C0?\u201D"
  - "\u201D\uC774\uC81C \uC6B0\uB9AC\uAC00 \uCE58\uB8CC\uD574\uC904\uAC8C!\u201D"
  - "\uB0B4 \uC77C\uAE30\uC7A5\uC740 \uADF8\uB4E4\uC774 \uB9C9\uBB34\uAC00\uB0B4\uB85C
    \uADF8\uB9B0\n\uAD34\uC0C1\uD55C \uB099\uC11C\uB85C \uAC00\uB4DD \uCC3C\uB2E4."
  - "\uC606\uC5D0 \uBAA8\uC778 \uB3D9\uAE09\uC0DD \uBA87\uC740 \uBA38\uBB47\uAC70\uB9AC\uB294\uAC00
    \uC2F6\uB354\uB2C8\n\uC5B4\uB290\uC0CC\uAC00 \uADF8\uB140\uC758 \uAC70\uCE68\uC5C6\uB294
    \uD589\uB3D9\uC5D0 \uB3D9\uCC38\uD588\uB2E4."
  - "\uD615\uCCB4\uB97C \uC54C\uC544\uBCFC \uC218 \uC5C6\uB294 \uADF8\uB9BC,\n\uD53C\uB208\uBB3C\uC774
    \uB9FA\uD78C \uB208, \uBAA9\uC774 \uC798\uB824\uB098\uAC04 \uC0AC\uB78C."
  - "\uBBF8\uCCD0\uBC84\uB9B4 \uAC83 \uAC19\uC558\uC9C0\uB9CC\n\uB098\uB294 \uC544\uBB34\uAC83\uB3C4
    \uD560 \uC218 \uC5C6\uC5C8\uB2E4."
  - "\u201D\uD734.\u201D"
  - "\u201D\uC774\uC81C \uC880 \uB098\uC544\uC84C\uB098?\u201D"
  - "\uB140\uC11D\uC774 \uC774\uB9C8\uC5D0 \uB9FA\uD78C \uB540\uC744 \uB2E6\uC544\uB0B4\uBA70
    \uB9D0\uD588\uB2E4."
  - "\uCC28\uB77C\uB9AC \uB178\uB824\uBCF4\uC558\uB2E4\uBA74 \uB098\uC558\uC744 \uAC83\uC774\uB2E4."
  - "\uB140\uC11D\uC740 \uADF8 \uB300\uC2E0\n\uCC22\uC5B4\uC9C8 \uB4EF\uC774 \uC62C\uB9B0
    \uC785\uAF2C\uB9AC\uB85C \uB2F5\uD588\uB2E4."
  - "\uBAA8\uC5EC\uB4E0 \uBAA8\uB450\uAC00 \uB098\uB97C \uB458\uB7EC\uC2F8\uACE0
    \uC6C3\uC5C8\uB2E4."
  - "\uC21C\uAC04 \uC218\uC5C5\uC885\uC774 \uAD50\uC2E4\uC5D0 \uC6B8\uB824 \uD37C\uC84C\uB2E4."
  - "\u201D\uC74C\uCE68\uD55C \uC0C8\uB07C.\u201D"
  - "\u201D\uC65C \uACC4\uC18D \uB098\uC624\uB294\uAC70\uC57C?\u201D"
  - "\uCD09\uC774 \uBD80\uB7EC\uC9C4 \uD39C\uC774 \uB0B4 \uAC00\uC2B4\uD30D\uC73C\uB85C
    \uB0A0\uC544\uB4E4\uC5C8\uB2E4."
  - "\uC544\uD504\uC9C4 \uC54A\uC558\uB2E4."
  charInterval: 0.05
  clearOnEnable: 1
