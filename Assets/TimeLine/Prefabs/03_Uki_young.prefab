--- !u!114 &7835733187971232220
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8898757048355978033}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 917d3f7fb8b12cc4db2bed1e7676fca3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KTH.KTH_TypingTextSignal
  text: {fileID: 2772539605590323886}
  lines:
  - "\uC544\uC774\uC2A4\uD06C\uB9BC \uD2B8\uB7ED\uC740 \uB298 \uD558\uAD63\uAE38
    \uD55C \uBCF5\uD310\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
  - "\uD558\uC580 \uC18C\uD504\uD2B8\uB97C \uBA39\uACE0 \uC2F6\uC5B4\uC11C \uBD80\uBAA8\uB2D8\uAED8
    \uC6A9\uB3C8\uC744 \uBC1B\uC544\uBCFC\uAE4C \uD588\uC9C0\uB9CC\n\uC9D1\uC73C\uB85C
    \uB0A0\uC544\uB4DC\uB294 \uBBF8\uB0A9 \uBB38\uC11C\uB4E4\uC758 \uC218\uB97C \uC0C8\uC5B4\uBCF4\uACE4
    \uADF8\uB9CC \uB450\uC5C8\uB2E4."
  - "\uAC00\uB054 \uC9D1\uC73C\uB85C \uC0C8\uCE74\uB9CC \uC591\uBCF5\uC744 \uC785\uC740
    \uC0AC\uB78C\uB4E4\uC774 \uCC3E\uC544\uC654\uB294\uB370,"
  - "\uADF8 \uB54C \uB9C8\uB2E4 \uBD80\uBAA8\uB2D8\uC740 \uC5F0\uC2E0 \uC8C4\uC1A1\uD558\uB2E4\uB294
    \uB9D0\uC744 \uBC18\uBCF5\uD558\uBA70\n\uC9D1\uC73C\uB85C \uB4E4\uC5B4\uC624\uB824\uB294
    \uADF8\uB4E4\uC744 \uC5B5\uC9C0\uB85C \uBC00\uC5B4\uB0B4\uC5C8\uB2E4."
  - "\uADF8 \uB0A0\uB3C4 \uC0C1\uC0C1\uC73C\uB85C \uC218\uBC31 \uBC88\uC744 \uBA39\uC740\n\uC18C\uD504\uD2B8\uB97C
    \uCCD0\uB2E4\uBCF4\uACE0 \uC788\uC5C8\uB2E4."
  - "\uC544\uC774\uC2A4\uD06C\uB9BC \uD2B8\uB7ED\uC758 \uBC1D\uC740 \uC74C\uC545\uACFC
    \uD0C8\uCF64\uD55C \uC2DC\uB7FD \uB0C4\uC0C8\uAC00\n\uBA40\uB9AC\uAE4C\uC9C0
    \uC804\uD574\uC84C\uB2E4."
  - "\uADF8\uB7F0 \uB0B4 \uC606\uC73C\uB85C \uC5B4\uB5A4 \uB0A8\uC790\uAC00 \uB2E4\uAC00\uC654\uB2E4."
  - "\u201D\uD639\uC2DC \uC544\uC774\uC2A4\uD06C\uB9BC\uC774 \uBA39\uACE0 \uC2F6\uC5B4\uC11C\n\uB9E4\uC77C
    \uC11C \uC788\uB294 \uAC70\uB2C8?\u201D"
  - "20\uB300 \uC815\uB3C4 \uB418\uC5B4 \uBCF4\uC774\uB294 \uB0A8\uC790\uC600\uB2E4."
  - "\uB098\uB294 \uC544\uC774\uC2A4\uD06C\uB9BC\uC774 \uB108\uBB34 \uBA39\uACE0
    \uC2F6\uC5C8\uAE30\uC5D0\n\uB098\uB3C4 \uBAA8\uB974\uAC8C \uB300\uB2F5\uD588\uB2E4."
  - "\u201D..\uB124.\u201D"
  - "\uADF8\uB7EC\uC790 \uB0A8\uC790\uB294 \uB098\uB97C \uC9C0\uB098\uCCD0\n\uAC00\uAC8C
    \uC8FC\uC778\uC5D0\uAC8C \uB3C8\uC744 \uB0B4\uBC00\uC5C8\uB2E4."
  - "\uACF3 \uC774\uC5B4 \uADF8\uB294 \uC544\uC774\uC2A4\uD06C\uB9BC \uB450 \uAC1C\uB97C
    \uC591 \uC190\uC5D0 \uB4E4\uACE0\n\uD558\uB098\uB97C \uB0B4\uAC8C \uAC74\uB0C8\uB2E4."
  - "\u201D\uC5EC\uAE30\uB97C \uB9E4\uC77C \uC9C0\uB098\uCE58\uB294\uB370, \uD56D\uC0C1
    \uC11C \uC788\uB354\uB77C\uACE0.\u201D"
  - "\u201D\uB098\uC911\uC5D0\uB3C4 \uBA39\uACE0 \uC2F6\uC73C\uBA74 \uC5EC\uAE30\uC11C
    \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5B4.\u201D"
  - "\u201D\uC640! \uAC10\uC0AC\uD569\uB2C8\uB2E4!\u201D"
  - "\uB098\uB294 \uB108\uBB34\uB098 \uAE30\uBEE4\uB2E4."
  - "\uD0DC\uC5B4\uB098\uC11C \uCC98\uC74C\uC73C\uB85C \uB9DB\uBCF4\uB294 \uC544\uC774\uC2A4\uD06C\uB9BC\uC740\n\uB0B4
    \uC0C1\uC0C1 \uBCF4\uB2E4 \uB2EC\uCF64\uD588\uB2E4."
  - "\uD558\uC9C0\uB9CC \uAE30\uC068\uC740 \uADF8\uB9AC \uC624\uB798\uAC00\uC9C0
    \uC54A\uC558\uB2E4."
  - "\uC774\uB807\uAC8C \uB9DB\uC788\uB294 \uC74C\uC2DD\uC744 \uB098\uB9CC \uBA39\uB294
    \uAC83\uC740\n\uB9D0\uC774 \uB418\uC9C0 \uC54A\uC558\uB2E4."
  - "\u201D\uC800\uAE30, \uBB34\uC2A8 \uC77C \uC788\uB2C8?\u201D"
  - "\uAC11\uC790\uAE30 \uC6B8\uC74C\uC744 \uD130\uB728\uB9AC\uB294 \uB0B4 \uBAA8\uC2B5\uC5D0\n\uB0A8\uC790\uB294
    \uB2F9\uD669\uD55C \uB4EF \uBB3C\uC5C8\uB2E4."
  - "\u201D\uC544\uB2C8\uC694.. \uADF8\uB0E5, \uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC5D0\uC694.\u201D"
  - "\uB0A8\uC790\uB294 \uBA87 \uCD08\uAC04 \uAD73\uC5B4\uC788\uB2E4\uAC00 \uC8FC\uBA38\uB2C8\uC5D0\uC11C
    \uAEBC\uB0B8 \uC885\uC774 \uC870\uAC01\uC5D0\n\uBB34\uC5B8\uAC00\uB97C \uB0A0\uB824\uC4F4
    \uD6C4 \uB2E4\uC2DC \uC9D1\uC5B4\uB123\uC5C8\uB2E4."
  charInterval: 0.05
  clearOnEnable: 1
  typingSfx: {fileID: 8300000, guid: babdb331464db794aa4a7a31388a951c, type: 3}
  typingSfxVolume: 0.35
  typingSfxMinInterval: 0.06
  typingSfxPitch: {x: 0.95, y: 1.05}
