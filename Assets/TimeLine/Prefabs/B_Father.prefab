--- !u!114 &4442419812908559653
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1916886761727438200}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 917d3f7fb8b12cc4db2bed1e7676fca3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KTH.KTH_TypingTextSignal
  text: {fileID: 207049366841303698}
  lines:
  - "\uC5B4, B\uC528\uC758 \uC774\uC57C\uAE30\uC694?"
  - "\uC800\uB3C4 \uC798 \uAE30\uC5B5\uC774 \uC548\uB098\uC9C0\uB9CC, \uCD5C\uB300\uD55C
    \uB4E4\uB824 \uB4DC\uB9B4\uAC8C\uC694."
  - "\uB098\uB294 \uCC28\uAC00\uC6B4 \uC544\uCE68 \uACF5\uAE30\uC5D0 \uB208\uC744
    \uB5B4\uB2E4."
  - "\uD3D0\uB97C \uCC44\uC6B0\uB294 \uD55C\uAE30\uC5D0 \uBAB8\uC774 \uB5A8\uB838\uB2E4."
  - "\uACB0\uAD6D \uC7A0\uB4E4\uC5B4\uBC84\uB9B0 \uB098\uB97C \uD0D3\uD558\uBA70,\n\uC544\uBC84\uC9C0\uC758
    \uC190\uC744 \uC7A1\uC558\uB2E4."
  - "\uBBF8\uC57D\uD55C \uC628\uAE30\uAC00 \uB290\uAEF4\uC84C\uB2E4."
  - "\u201D\u2026\uC77C\uC5B4\uB0AC\uAD6C\uB098.\u201D"
  - "\u201D\uC5EC\uAE30, \uBB3C\uC774\uC694.\u201D"
  - "\uC544\uBC84\uC9C0\uC758 \uAC08\uB77C\uC9C0\uB294 \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC744\uC218\uB85D\n\uB0B4
    \uC790\uC2E0\uC744 \uC6A9\uC11C\uD560 \uC218 \uC5C6\uC5C8\uB2E4."
  - "\uC774\uC0C1\uC785\uB2C8\uB2E4."
  - "\uC544\uBC84\uC9C0\uAC00 \uC790\uB791\uC2A4\uB7EC\uC6B4 \uD45C\uC815\uC73C\uB85C
    \uC5F0\uB2E8\uC744 \uB0B4\uB824\uC654\uB2E4."
  - "\uB05D\uC5C6\uC774 \uC3DF\uC544\uC9C0\uB294 \uBC15\uC218 \uAC08\uCC44\uC640
    \uD568\uAED8\n\uCC2C\uC0AC\uAC00 \uC774\uC5B4\uC84C\uB2E4."
  - "\u201D\uC798 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.\u201D"
  - "\u201D\uD639\uC2DC, \uC5F0\uAD6C\uB97C \uD65C\uC6A9\uD558\uACE0 \uC2F6\uC740\uB370\n\uB530\uB85C
    \uB9CC\uB0A8\uC744 \uAC00\uC9C8 \uC218 \uC788\uC744\uAE4C\uC694?\u201D"
  - "\uD55C \uC80A\uC740 \uD559\uD68C\uC6D0\uC774 \uBB3C\uC5C8\uB2E4."
  - "\uC544\uBC84\uC9C0\uB294 \uD754\uCF8C\uD788 \uC218\uB77D\uD588\uB2E4."
  - "\uADF8\uAC00 \uD3C9\uC0DD\uC744 \uAC78\uCCD0 \uB2E4\uB4EC\uC740 \uC644\uBCBD\uD55C
    \uC2EC\uB9AC \uC774\uB860\uC740,"
  - "\uBAA8\uB4E0 \uC815\uC2E0 \uC99D\uC138\uB294 \uBB3C\uB860\n\uD55C \uC0AC\uB78C\uC758
    \uAC00\uCE58\uAD00\uC744 \uBC14\uAFC0 \uC218 \uC788\uB294 \uD798\uC744 \uAC00\uC9C0\uACE0
    \uC788\uC5C8\uB2E4."
  - "\uC5B4\uCA4C\uBA74 \uC774\uB7F0 \uC81C\uC548\uC774 \uC624\uC9C0 \uC54A\uB294
    \uAC83\uC774 \uC774\uC0C1\uD588\uC744 \uAC83\uC774\uB2E4."
  - "\uD558\uC9C0\uB9CC \uC544\uBC84\uC9C0\uB294 \uADF8 \uB0A8\uC790\uB97C \uB9CC\uB098\uB7EC\uAC04\uC9C0\n\uBC18\uB098\uC808\uC774
    \uCC44 \uC9C0\uB098\uC9C0 \uC54A\uC544 \uB3CC\uC544\uC654\uB2E4."
  - "\uC544\uBC84\uC9C0\uB294 \uADF8\uB4E4\uC774 \uC0AC\uAE30\uC5C5\uC5D0\uC11C \uC628
    \uC9C1\uC6D0\uC774\uACE0,"
  - "\uC790\uC2E0\uC758 \uC774\uB860\uC744 \uC138\uB1CC\uC5D0 \uC545\uC6A9\uD560
    \uC758\uB3C4\uAC00 \uBCF4\uC778\uB2E4\uBA70\n\uBD84\uB178\uB97C \uAC10\uCD94\uC9C0
    \uBABB\uD588\uB2E4."
  - "\uADF8\uB294 \uD559\uD68C\uC5D0 \uC815\uBCF4 \uBCF4\uD638\uB97C \uC694\uCCAD\uD588\uC9C0\uB9CC\n\uC774\uBBF8
    \uC815\uBCF4\uB294 \uB1CC\uBB3C \uC904\uAE30\uB97C \uB530\uB77C \uD758\uB7EC\uAC04
    \uD6C4\uC600\uB2E4."
  - "\uD559\uD68C\uB294 \uB0B4\uB0B4 \uBAA8\uB974\uACA0\uB2E4\uB294 \uD0DC\uB3C4\uB97C
    \uBCF4\uC600\uC9C0\uB9CC\n\uC544\uBC84\uC9C0\uC758 \uB048\uC9C8\uAE34 \uB9E4\uB2EC\uB9BC\uC5D0
    \uC815\uBCF4\uB97C \uB118\uAE34 \uC0AC\uC2E4\uC744 \uBC1D\uD614\uB2E4."
  - "\uADF8\uB9AC\uACE0, \uADF8\uB4E4\uC740 \uBC1B\uC740 \uB3C8\uC758 8 \uD560\uC744
    \uC81C\uC548\uD588\uB2E4."
  - "\uC544\uBC84\uC9C0\uB294 \uADF8 \uC21C\uAC04 \uADF8\uC758 \uBA74\uC0C1\uC744
    \uD6C4\uB824\uAC08\uACBC\uB2E4."
  - "\uC774 \uBAA8\uB4E0 \uBD80\uD328\uB97C \uAE30\uC790\uB97C \uBD88\uB7EC \uC54C\uB9AC\uACA0\uB2E4\uB294
    \uB9D0\uACFC \uD568\uAED8\n\uADF8\uB294 \uC9D1\uC73C\uB85C \uB3CC\uC544\uC654\uB2E4."
  - "\uD558\uC9C0\uB9CC \uACC4\uD68D\uD55C \uB2F9\uC77C \uAE30\uC790\uB294 \uD55C
    \uBA85\uB3C4 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4."
  - "\uC544\uBC84\uC9C0\uB294 \uC678\uB85C\uC774 \uB2E8\uC0C1\uC5D0 \uC62C\uB77C
    \uD3ED\uB85C\uB97C \uC2DC\uC791\uD588\uB2E4."
  - "\uADF8\uB294 \uBD84\uB178\uD558\uACE0, \uB208\uBB3C\uC744 \uD6D4\uCE58\uBA70\n\uD55C
    \uC90C\uC758 \uD68C\uC6D0\uB4E4 \uC55E\uC5D0\uC11C \uAE38\uC9C0 \uC54A\uC740
    \uC5F0\uC124\uC744 \uC774\uC5B4\uAC14\uB2E4."
  - "\uC5BC\uB9C8\uB098 \uC9C0\uB0AC\uC744\uAE4C."
  - "\uC5B4\uB518\uAC00 \uC5B4\uB824 \uBCF4\uC774\uB294 \uAE30\uC790 \uD55C \uBA85\uC774\n\uAC70\uB300\uD55C
    \uBB38\uC744 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uBC00\uC5B4 \uC5F4\uC5C8\uB2E4."
  - "\uADF8\uC640 \uB3D9\uC2DC\uC5D0 \uC544\uBC84\uC9C0\uB294 \uB2E8\uC0C1\uC5D0\uC11C
    \uB04C\uC5B4 \uB0B4\uB824\uC84C\uB2E4."
  - "\uACBD\uCC30\uC774 \uB4E4\uC774\uB2E5\uCE5C \uAC83\uC740 \uB2E4\uC74C\uB0A0
    \uC544\uCE68\uC774\uC5C8\uB2E4."
  - "\uC18C\uB780\uC2A4\uB7FD\uAC8C \uBB38\uB4E4 \uBD80\uC218\uACE0 \uB4E4\uC5B4\uC628
    \uADF8\uB4E4\uC740\n\uC544\uBC84\uC9C0\uB97C \uCCB4\uD3EC\uD574 \uC5B4\uB518\uAC00\uB85C
    \uB04C\uACE0 \uC0AC\uB77C\uC84C\uB2E4."
  - "\uB098\uB294 \uADF8\uB4E4\uC744 \uB9C9\uC73C\uB824\uACE0 \uBC1C\uBC84\uB465
    \uCCE4\uC9C0\uB9CC\n\uC804\uD600 \uB3C4\uC6B8 \uC218 \uC5C6\uC5C8\uB2E4."
  - "\uCC28\uB77C\uB9AC \uACBD\uAD00\uC758 \uCF67\uB4F1 \uC704\uC5D0 \uC549\uC740\n\uD30C\uB9AC
    \uD55C \uB9C8\uB9AC\uAC00 \uB354 \uB098\uC558\uC744 \uAC83\uC774\uB2E4."
  - "\uC544\uBC84\uC9C0\uB294 \uC774\uD2C0 \uB4A4\uC5D0 \uB3CC\uC544\uC654\uB2E4."
  - "\uC628 \uBAB8\uC758 \uBF08\uAC00 \uBD80\uC11C\uC9C0\uACE0, \uAD00\uC808\uC774
    \uC5B4\uAE0B\uB098\uACE0,\n\uBAA9 \uB2E8\uC804\uC5D0\uC11C \uD53C\uAC00 \uD750\uB974\uB294
    \uBAA8\uC2B5\uC73C\uB85C."
  - "\u201D\uC544\uBC84\uC9C0, \uC544\uBC84\uC9C0?\u201D"
  - "\uAC11\uC790\uAE30 \uADF8\uC758 \uC190\uC5D0\uC11C \uD798\uC774 \uD480\uB838\uB2E4."
  - "\uB098\uB294 \uADF8\uC758 \uAC00\uC2B4\uD30D\uC5D0 \uADC0\uB97C \uB300\uC5C8\uB2E4."
  - "\uC57D\uD55C \uC228\uC18C\uB9AC\uC640 \uC2EC\uC7A5 \uBC15\uB3D9\uC774 \uB290\uAEF4\uC84C\uB2E4."
  - "\u201D..\uB098\uB294 \uC2E0\uACBD\uC4F0\uC9C0 \uB9C8\uB77C.\u201D"
  - "\u201D\uBD80\uD0C1\uD558\uB9C8..\uB108\uC758 \uC0B6\uC744 \uC0B4\uC544.\u201D"
  - "\uADF8\uAC00 \uD55C \uB540 \uD55C \uB540 \uB2EB\uD600\uAC00\uB294 \uB9C8\uB978
    \uC785\uC220\uB85C \uB9D0\uD588\uB2E4."
  - "\uADF8\uB9AC\uACE0 \uADF8\uAC8C \uB0B4\uAC00 \uB4E4\uC744 \uC218 \uC788\uC5C8\uB358,\n\uB9C8\uC9C0\uB9C9
    \uD55C \uB9C8\uB514\uC600\uB2E4."
  charInterval: 0.05
  clearOnEnable: 1
