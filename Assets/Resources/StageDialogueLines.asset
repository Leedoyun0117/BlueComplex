%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2836c597d7b74f6dbba61c2ba2738b5d, type: 3}
  m_Name: StageDialogueLines
  m_EditorClassIdentifier: Assembly-CSharp::BlueComplex.UI.Presentation.StageDialogueLines
  _entries:
  - stageId: stage_1
    label: '1 - 가라앉다'
    stageStartFirst:
      lines:
      - speaker: 1
        text: '…B씨?'
      - speaker: 1
        text: '아, 아니네요.. 아저씨는 누구세요?'
      - speaker: 0
        text: '널 도와주러 왔어.'
      - speaker: 1
        text: '네? 하지만 저는 별로 도움이 필요하지 않은데요.'
      - speaker: 1
        text: '아, 아저씨도 소문 들으셨구나? 며칠 전에 이사오는 소리가 들리긴 했는데.'
      - speaker: 0
        text: '그게 무슨 말이니?'
      - speaker: 1
        text: '아무것도 아니에요. 그냥 애들 장난 같은건데.. 확실히 유치한 소문이거든요.'
      - speaker: 0
        text: '잠깐 대화할 수 있을까?'
      - speaker: 1
        text: '네 뭐, 좋아요.'
    stageStartReplay:
    - lines:
      - speaker: 1
        text: '아저씨는 누구세요?'
      - speaker: 0
        text: '유키, 잠깐 대화 나눌 수 있을까?'
      - speaker: 1
        text: '잠깐, 언제 만난 적 있지 않아요? 아닌가..'
      - speaker: 0
        text: '어.. 확실히 처음인 것 같네.'
      - speaker: 1
        text: '음? 그럼 제 이름은 어떻게 아신건지.. 아무튼 그래요, 편하게 앉으세요.'
    - lines:
      - speaker: 1
        text: '거기, 누구 있어요?'
      - speaker: 0
        text: '유키, 안녕.'
      - speaker: 1
        text: 'B씨? 어, 아닌 것 같은데. 혹시 B씨랑 아는 분인가요?'
      - speaker: 0
        text: 'B씨? 처음 듣는데. 그보다 잠깐 대화할 수 있을까 해서.'
      - speaker: 1
        text: '그래요. 좀 심심하던 참이었거든요.'
    - lines:
      - speaker: 0
        text: '유키, 거기 있니?'
      - speaker: 1
        text: '네? 아직 돌아올 시간이 아닌데.. B씨?'
      - speaker: 0
        text: '음.. 나는 B씨? 처음 듣는데. 그건 그렇고, 어제 옆 건물로 이사 와서 인사 차 방문했어'
      - speaker: 1
        text: '아, 어제 건물이 한참 시끄럽긴 했어요.'
      - speaker: 0
        text: '잠깐 대화할 수 있을까?'
      - speaker: 1
        text: '네, 좋아요.'
    quarterEnd:
      excited:
      - lines:
        - speaker: 1
          text: '만약 세상이 전부 브로콜리이고, 내가 그 속에 서 있어야 한다면, 차라리 모두 먹어버릴 거에요.'
      - lines:
        - speaker: 1
          text: '엄마의 쿠키 굽는 실력을 아셔야 하는데! 겉은 조금 거칠지만 안쪽의 부드러운 반죽이 정말 맛있거든요. 아, 평생 이렇게만 살 수 있다면 얼마나 좋을까요'
      - lines:
        - speaker: 1
          text: '차라리 그 아이들을 전부 없애버리면 속이 편할 것 같아요. 그 쓰레기들이 무슨 짓을 했는지 아셔야 하는데.'
      stable:
      - lines:
        - speaker: 1
          text: '어제는 아프다는 핑계를 대고 학교를 빠졌어요. 그 대신, 엄마, 아빠하고 나들이를 다녀왔어요. 날씨만 좋았더라면 즐거웠을 텐데.'
      - lines:
        - speaker: 1
          text: '요즈음은 별로 아무 생각이 없어요. 사실 학교에서 잠만 자기 시작하니까 주변이 좀 조용해 졌거든요. 그 때문에 목이 좀 뻐근하긴 하지만.'
      - lines:
        - speaker: 1
          text: '오늘은 하늘이 보여요. 어제까지만 해도 비가 내렸는데, 다행이네요.'
      depressed:
      - lines:
        - speaker: 1
          text: '지금은 낙서 때문에 전부 망쳤지만, 원래는 일기장이에요. 누가 그랬냐고요?…'
      - lines:
        - speaker: 1
          text: '그냥 집에만 누워있고 싶어요. 전부 귀찮다고요.'
      - lines:
        - speaker: 1
          text: '맛있는 음식을 먹어도 나무 껍질 맛이 나서.. 그냥 씹어 삼키게 돼요. 쿠키 반죽의 향긋함을 잊어버리는 건 싫은데..'
      - lines:
        - speaker: 1
          text: '저 좀 그만 귀찮게 하세요. 아저씨도 절 괴롭히러 온 거 아니죠?'
    stageClear:
      excited:
      - lines:
        - speaker: 1
          text: '이제 끝인가요? 좀 더 대화할 수 있을까요?'
      stable:
      - lines:
        - speaker: 1
          text: '..이제 끝인가요? 이야기 나눌 수 있어서 좋았어요.'
      depressed:
      - lines:
        - speaker: 1
          text: '..뭔가, 알 수 없는 기분이 들어요. 이제 끝난건가요?'
