%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45810c43d7b4449a925d626775105968, type: 3}
  m_Name: ComplexReactionLines
  m_EditorClassIdentifier: Assembly-CSharp::BlueComplex.UI.Presentation.ComplexReactionLines
  _entries:
  - complexId: complex_good_child
    label: 착한 아이
    lines:
    - '이렇게 행복했던 건, 내가 착했기 때문이야.'
    - '내가 착하지 않다는 걸 알았다면, 행복하지 못했을까?'
    - '행복했어, 내가 친절했던 만큼 말이야.'
  - complexId: complex_anti_past
    label: 반 과거
    lines:
    - '다 지나간 일이야. 별로 기억하고 싶지 않다고.'
    - '내가 왜 그랬을까? 돌이켜 보면 이해하지 못하겠어.'
    - '내가 행복했다고? 전부 만들어진 허상이겠지.'
  - complexId: complex_childhood_friend
    label: 소꿉친구
    lines:
    - '.. 어릴 적을 추억하는 행동은 모두가 하지 않을까?'
    - '어릴 때부터 함께였다는 건… 역시 조금 특별한 의미가 있는 거 아닐까?'
    - '그렇게 오랫동안 기억하고 있다는 건, 평범한 친구였기 때문만은 아닐 거야.'
    - '어릴 적 친구를 아직도 떠올린다는 건… 분명 그만한 이유가 있는 거겠지?'
    - '친구라고 하기엔 너무 오래 남아 있잖아. 어쩌면 처음부터 조금 달랐던 걸지도 몰라.'
    - '어린 시절부터 함께한 사람이라면… 다른 사람과 똑같이 생각할 수는 없지 않을까?'
  - complexId: complex_othering
    label: 타자화
    lines:
    - '사실 그 사람과는 별 관계가 아니었어.'
    - '나는 나고, 그 사람은 그 사람인거지.'
    - '내가 만약 의미 있는 관계라고 생각했어도, 지금은 아닌걸.'
    - '서로 다른 각자의 삶을 사는거야.'
  - complexId: complex_optimism
    label: 낙관
    lines:
    - '…다 괜찮아.'
    - '다른 면에서 보면 전부 좋은 일일거야.'
    - '부정은 아무런 의미가 없어.'
    - '전부 괜찮을 거야..'
  - complexId: complex_rumination
    label: 되새김
    lines:
    - '계속 떠올라. 이제 그만하고 싶은데..'
    - '기억 해서 좋을 게 뭐가 있다고.'
    - '머리를 한 대 내려 치면 잊어버릴 수 있을까?'
  - complexId: complex_guilt
    label: 죄책감
    lines:
    - '왜 인지 가슴 한 곳이 빈 것 같아. 차라리 내가 없어지면, 다 해결되지 않을까?'
    - '이제 돌아갈 수 없겠지.. 내가 그렇게 행복한 기억을 가질 자격이 있을까?'
    - '이런 감정은 나처럼 금방 잊는 사람보다 다른 이에게 더 필요했을 텐데.'
    - '이렇게 행복한 추억을 가지고, 이런 삶을 살아도 되는 걸까?'
  - complexId: complex_dependence
    label: 의존
    lines:
    - '아무렇지도 않아. 정말로. 하지만, 딱 한번만 볼 수 있으면..'
    - '..혼자 할 수 있다고 착각했나봐..'
    - '내 일부가 사라진 기분이야.'
    - '좋았던 시절이 그리워.'
  - complexId: complex_avoidance
    label: 회피
    lines:
    - '아니야. 이미 지나간 일이야. 제발.. 그래야만 해.'
    - '이미 견뎌 본 일일거야. 기억에는 없지만..'
    - '나는 자고 일어났고, 그 일은 어제가 되어있어.'
    - '그냥 눈을 감고 지나가길 기다려.'
  - complexId: complex_stockholm
    label: 스톡홀름
    lines:
    - '나를 해치는 사람도 나에게 관심이 있어서 그러는 거겠지. 사실 정말 관심 없으면 건드리지도 않는다고.'
    - '정말 아무 감정도 없었다면, 굳이 나한테 그렇게까지 하진 않았을 거야.'
    - '상처를 줬다고 해서 전부 미워했던 건 아닐지도 몰라. 관심이 있으니까 그런 거겠지.'
    - '이상하지만… 나를 신경 쓰지 않았다면 애초에 그렇게 집착하지도 않았을 거야.'
    - '무서웠던 건 맞아. 그래도 그 사람이 나를 계속 보고 있었다는 건 사실이잖아.'
    - '방법이 잘못됐을 뿐이지… 어쩌면 나를 생각하고 있었던 걸지도 모르잖아.'
  - complexId: stage2_past_denial
    label: 과거 부정
    lines:
    - '과거의 감정은 진짜가 아니야.'
    - '뭔가 착각했을 거야.'
    - '내가 그런 감정을 느꼈을 리가 없어.'
    - '녹슬어서 어긋난 시곗 바늘을 보며 일하러 나가는 사람은 없어.'
  - complexId: stage2_kind_child
    label: 착한아이 (스테이지 2)
    lines:
    - '이렇게 행복했던 건, 내가 착했기 때문이야.'
    - '내가 착하지 않다는 걸 알았다면, 행복하지 못했을까?'
    - '행복했어, 내가 친절했던 만큼 말이야.'
  - complexId: stage2_mixed_emotion
    label: 복합 감정
    lines:
    - '왜 이렇게 복잡한거야? 혼란스러워.'
    - '이건 무슨 감정인거야?'
    - '검정색의 처음을 종이가 이해할 수 있을 거라 생각하지 마.'
    - '나조차 이해하지 못하는거야?'
  - complexId: stage2_rationalization
    label: 합리화
    lines:
    - '그렇게 깊은 관계도 아니었어. 이렇게 신경 쓸 필요가 없다고.'
    - '내 삶은 나 혼자서 살아가는 거야. 아무리 가까워도 결국 다른 사람인 걸.'
    - '차라리 다른 사람이라고 생각할래.'
    - '이런다고 나한테 좋은 일이 생길까?'
  - complexId: stage2_self_blame
    label: 자책
    lines:
    - '왜 하필 가족이었을까? 차라리 다른 사람이나, 하다 못해 친구였다면? 아니. 분명 나였어야 했는데.'
    - '내가 바꿀 수 있었을까? 내가 좀 더 노력했다면, 결말이 달랐을까?'
    - '내가 바꿀 수 없었다는 사실을 인정하고 싶지 않아. 전부 정해진 운명이었던 걸까?'
  - complexId: stage2_over_expectation
    label: 과한 기대
    lines:
    - '너무 행복해. 내일도, 그 다음 날도, 그리고 몇 년 뒤 까지도 계속 행복 할게 분명해.'
    - '확실히 나는 계속 행복할거야. 무슨 일이 있어도, 계속.'
    - '이 행복이 끝난다고? 그건 전부 질투하는 사람들의 거짓말이야.'
    - '지금부터 우울한 날들은 전부 끝이야. 이제 난 평생 행복에 잠겨 환상적인 삶을 보낼 거거든!'
  - complexId: stage2_scattered_mind
    label: 의식 분산
    lines:
    - '이건 누구를 향한 감정이지?'
    - '나 자신? 가족? 아니면.. 다른 사람?'
    - '왜 이러는지 모르겠어.. 혼란스러워.'
  - complexId: stage2_self_anger
    label: 자기 분노
    lines:
    - '왜 이렇게 우울한거지? 나는 이정도도 견디지 못하는 건가?'
    - '고작 우울감 하나도 견디지 못한 내가 무슨 쓸모가 있다고.'
    - '산책을 나가거나 친구를 만날 용기조차 없으면서.'
    - '아무 것도 할 수 없고, 그냥 우울해 하기. 나 같은 건 차라리 죽는게 나아.'
  - complexId: stage2_transference
    label: 전이
    lines:
    - '그 사람이 가깝게 느껴져.'
    - '내가 그 사람을 잘 모르고 있던 것 같아. 돌이켜 보면 꽤 좋았을 지도.'
    - '마음 한 곳에 계속 남아있어.'
  - complexId: stage2_distrust
    label: 불신
    lines:
    - '정말 나를 위해 주는 게 맞을까? 그게 맞다고 해도, 내가 뭔가를 해야 할 것 같은 느낌이 들어.'
    - '전부를 내어주기엔 뭔가 꺼려져.'
    - '바늘 끝의 달콤함을 이미 삼켜버렸어. 그저 당기지 않길 바랄 뿐이야.'
    - '내가 그 사람이라면, 나를 좋아할까? 아닐텐데.'
  - complexId: stage2_over_interpretation
    label: 과대 해석
    lines:
    - '지금 감정이 제일 중요해. 다른 건 필요 없어.'
    - '오직 지금 순간이 의미 있는 거야. 과거나 미래는 잡을 수 없는 걸.'
    - '내 눈에 보이고, 내가 느끼는 건 지금 밖에 없어.'
    - '존재 하는 것이 그 의미 보다 중요해.'
  - complexId: stage2_persecution
    label: 피해 망상
    lines:
    - '어떻게 그럴 수 있지? 우리가 함께 한 시간이 아무것도 아니었던 건가?'
    - '역시 아무런 의미도 없던 거야. 전부 내 망상, 내 손으로 이끈 인형극에 불과한 걸.'
    - '처음부터 의지 하지 않았다면, 그랬다면 덜 고통스러울 텐데.'
  - complexId: stage2_overthinking
    label: 사고 과다
    lines:
    - '생각이 너무 많아서 어지러워.'
    - '머릿속이 너무 복잡해.'
    - '생각이 전부 얽혀서 꼬인 실타래가 되어 버렸어.'
  - complexId: stage3_futility
    label: 허망
    lines:
    - '옛날의 행복이 무슨 소용이겠어?'
    - '그때 행복했다고 해서 뭐가 달라져? 지금은 이렇게 됐는데.'
    - '좋은 기억이면 뭐 해. 떠올릴수록 더 허전하기만 한데.'
    - '차라리 행복하지 않았으면 덜 아팠을까?'
    - '웃고 있었네, 저때는. …그래서 더 슬픈 건가.'
    - '돌아갈 수도 없는 행복을 계속 기억해서 뭐 하겠어.'
  - complexId: stage3_lethargy
    label: 무기력
    lines:
    - '더 깊이 가라앉는 기분이야.'
    - '이제 올라갈 힘도 없어.'
    - '슬픈 건 알겠는데, 뭘 해야 할지도 모르겠어. 그냥 이대로 있고 싶어.'
    - '조금 괜찮아지는가 싶었는데… 역시 아니었나 봐.'
    - '몸까지 무거워진 기분이야. 아무것도 하고 싶지 않아.'
    - '그만 울고 싶은데… 그것조차 귀찮아.'
  - complexId: stage3_stockholm
    label: 스톡홀름(3)
    lines:
    - '조금 무서웠지만 내 마음 속에 계속 남아있는 건, 좋은 감정이 아닐까?'
    - '새장 속의 새는 날개를 다쳤어. 처음이 어떠했건, 결국엔 새장이 새를 위한 공간이 된거야.'
  - complexId: stage3_clinging
    label: 밀착
    lines:
    - '갑자기 친근하게 느껴져.'
    - '평범한 기억이 쌓여서 발목까지 덮었어. 나아가려 할 때, 계속 한 켠에서 느껴지는 걸.'
  - complexId: stage3_reflection
    label: 반사
    lines:
    - '왜 사라지지 않는걸까? 별로 좋은 감정도 아닌데 말이야.'
  - complexId: stage3_precipice
    label: 낭떠러지
    lines:
    - '지금의 우울함이 미래까지 이어질 것만 같아.'
    - '이 기분… 앞으로도 계속 이러면 어떡하지?'
    - '오늘만 그런 게 아니야. 내일도, 그다음 날도 계속 이럴 것 같아.'
    - '끝이 안 보여. 계속 아래로 떨어지는 것 같아.'
    - '언제까지 버텨야 하는 거지? 나아질 거라는 느낌이 전혀 없어.'
    - '잠깐만. 잠시 우울한 게 아니라면? 정말 평생 이렇게 살아야 한다면? 그럼 어떡하지?'
  - complexId: stage3_expectation_anxiety
    label: 기대 불안
    lines:
    - '왜 나에게 기대를 품는 걸까? 내일이 오지 않았으면 좋겠어.'
  - complexId: stage3_self_denial
    label: 자아 부정
    lines:
    - '이 감정은 진짜 내가 아니야.'
    - '내가 느끼는 진짜 감정은 정 반대라고. 이건.. 내가 아니야.'
  - complexId: stage3_parental_attachment
    label: 부모 애착
    lines:
    - '다른 건 중요하지 않아. 그냥, 옛날에 부모님과 보냈던 추억이 그리워.'
    - '다른 건 잘 기억도 안 나. 그냥… 함께  있었던 때가 제일 선명해.'
    - '그때로 돌아가고 싶어. 식탁도, 목소리도, 전부 그대로였던 때로.'
    - '이상하게 그 기억만 떠올리면 마음이 놓여. 집에 돌아온 것처럼.'
    - '잠깐만 더 떠올리고 있을래. 여기서 나오고 싶지 않아.'
  - complexId: stage3_time_mixing
    label: 시간 혼합
    lines:
    - '확실히 지나간 일이지?'
    - '이미 지나간 일인데, 방금 겪은 것 처럼 생생하게 남아있어.'
    - '지금 눈 앞에서 일어나고 있어. 그 때 나는 왜 가만히 있었지? 내가 왜 지금 그대로인 거지? 아니야. 내 눈 앞에서, 지금, 보인다고.'
  - complexId: stage3_past_avoidance
    label: 과거 회피
    lines:
    - '지금의 나와 과거의 나는 완전히 다른 사람 같아. 어색하고, 혐오스러워.'
  - complexId: stage3_time_interpretation
    label: 시간 해석
    lines:
    - '슬픈 개가 나를 물고 놓아주지 않아. 발로 차버릴 수 있다면 좋을 텐데.'
